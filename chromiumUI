local function C_29()
local script = G2L["29"];
	local UserInputService = game:GetService("UserInputService")
	
	-- References
	local sliderLine = script.Parent:WaitForChild("sliderline")
	local sliderDrag = sliderLine:WaitForChild("sliderdrag")
	local sliderFill = sliderLine:WaitForChild("sliderfill")
	local valueLabel = script.Parent:WaitForChild("value")
	
	-- Settings
	local MIN_VALUE = 0
	local MAX_VALUE = 100
	
	local dragging = false
	
	-- Hide fill bar by default on start
	sliderFill.Visible = false
	
	local function updateSlider(input)
		local linePositionX = sliderLine.AbsolutePosition.X
		local lineLineWidth = sliderLine.AbsoluteSize.X
	
		-- Calculate percentage along the line length
		local mouseX = input.Position.X
		local percentage = (mouseX - linePositionX) / lineLineWidth
	
		-- Lock strictly between 0 (left edge) and 1 (right edge)
		percentage = math.clamp(percentage, 0, 1)
	
		-- Move the drag handle
		sliderDrag.Position = UDim2.new(percentage, 0, 0.5, 0)
	
		-- Stretch the fill bar
		sliderFill.Size = UDim2.new(percentage, 0, 1, 0)
	
		-- Hide the fill bar when at 0%, reveal it as soon as you drag past 0
		sliderFill.Visible = (percentage > 0)
	
		-- Calculate and display value
		local currentValue = math.floor(MIN_VALUE + (percentage * (MAX_VALUE - MIN_VALUE)))
		valueLabel.Text = tostring(currentValue)
	end
	
	-- Input Listeners
	local function onInputBegan(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateSlider(input)
		end
	end
	
	sliderDrag.InputBegan:Connect(onInputBegan)
	sliderLine.InputBegan:Connect(onInputBegan)
	
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateSlider(input)
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end;
