-- StarterGui.ScreenGui.configsaving
local function C_2()
local script = G2L["2"];
	local TweenService = game:GetService("TweenService")
	local HttpService = game:GetService("HttpService")
	
	local screenGui = script:FindFirstAncestorWhichIsA("ScreenGui")
	if not screenGui then return end
	
	local FILE_NAME = "SavedConfigs.json"
	
	-- ============================================================================
	-- 1. LOCATE DESIGNED UI ELEMENTS
	-- ============================================================================
	local configNameBox = nil
	
	-- Aggressive search for the config input box
	for _, desc in ipairs(screenGui:GetDescendants()) do
		if desc:IsA("TextBox") and (desc.Name == "confignames" or desc.Name:lower():find("configname") or desc.Name:lower():find("configbox") or desc.Name:lower():find("input")) then
			configNameBox = desc
			break
		end
	end
	
	local configDropdown = screenGui:FindFirstChild("configdropdown", true)
	if not configDropdown then return end
	
	configDropdown.ClipsDescendants = true
	
	-- ============================================================================
	-- 2. MEASURE & PIN TOP ELEMENTS (Prevents Arrow & Text from moving down)
	-- ============================================================================
	local CLOSED_HEIGHT = configDropdown.AbsoluteSize.Y
	if CLOSED_HEIGHT < 20 then CLOSED_HEIGHT = 38 end
	local OPEN_HEIGHT = CLOSED_HEIGHT + 130
	
	local arrowObj = nil
	
	-- Pin existing top elements so opening the frame won't shift them down
	for _, child in ipairs(configDropdown:GetChildren()) do
		if child:IsA("GuiObject") and child.Name ~= "DropdownPanel" then
			if child:IsA("ImageLabel") or child:IsA("ImageButton") or 
				(child:IsA("TextLabel") and (child.Text:find("v") or child.Text:find("▼") or child.Name:lower():find("arrow"))) then
				arrowObj = child
			end
	
			local currentAbsY = child.AbsolutePosition.Y - configDropdown.AbsolutePosition.Y
			child.AnchorPoint = Vector2.new(child.AnchorPoint.X, 0)
			child.Position = UDim2.new(child.Position.X.Scale, child.Position.X.Offset, 0, currentAbsY)
		end
	end
	
	-- ============================================================================
	-- 3. CREATE SCROLLING PANEL FOR CONFIGS
	-- ============================================================================
	local dropdownPanel = configDropdown:FindFirstChild("DropdownPanel")
	if dropdownPanel then dropdownPanel:Destroy() end
	
	dropdownPanel = Instance.new("ScrollingFrame")
	dropdownPanel.Name = "DropdownPanel"
	dropdownPanel.Size = UDim2.new(1, -12, 0, OPEN_HEIGHT - CLOSED_HEIGHT - 10)
	dropdownPanel.Position = UDim2.new(0, 6, 0, CLOSED_HEIGHT + 4)
	dropdownPanel.BackgroundTransparency = 1
	dropdownPanel.BorderSizePixel = 0
	dropdownPanel.Visible = false
	dropdownPanel.ScrollingEnabled = true
	dropdownPanel.ScrollBarThickness = 4
	dropdownPanel.ScrollBarImageColor3 = Color3.fromRGB(180, 180, 180)
	dropdownPanel.CanvasSize = UDim2.new(0, 0, 0, 0)
	dropdownPanel.ZIndex = configDropdown.ZIndex + 20
	dropdownPanel.Parent = configDropdown
	
	local listLayout = Instance.new("UIListLayout")
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Padding = UDim.new(0, 4)
	listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	listLayout.Parent = dropdownPanel
	
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 4)
	padding.PaddingBottom = UDim.new(0, 4)
	padding.PaddingLeft = UDim.new(0, 2)
	padding.PaddingRight = UDim.new(0, 2)
	padding.Parent = dropdownPanel
	
	-- Dynamic Canvas Sizing for scrolling
	local function updateCanvas()
		dropdownPanel.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 12)
	end
	listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)
	
	-- ============================================================================
	-- 4. TOGGLE & ARROW ANIMATION
	-- ============================================================================
	local isDropdownOpen = false
	local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	
	local function setDropdownState(open)
		isDropdownOpen = open
	
		-- Animate Arrow Flipping 180 degrees
		if arrowObj then
			TweenService:Create(arrowObj, tweenInfo, {
				Rotation = isDropdownOpen and -90 or 90
			}):Play()
		end
	
		if isDropdownOpen then
			dropdownPanel.Visible = true
			TweenService:Create(configDropdown, tweenInfo, {
				Size = UDim2.new(configDropdown.Size.X.Scale, configDropdown.Size.X.Offset, 0, OPEN_HEIGHT)
			}):Play()
		else
			local closeTween = TweenService:Create(configDropdown, tweenInfo, {
				Size = UDim2.new(configDropdown.Size.X.Scale, configDropdown.Size.X.Offset, 0, CLOSED_HEIGHT)
			})
			closeTween:Play()
			closeTween.Completed:Connect(function()
				if not isDropdownOpen then
					dropdownPanel.Visible = false
				end
			end)
		end
	end
	
	local function toggleDropdown()
		setDropdownState(not isDropdownOpen)
	end
	
	-- Attach click handlers to top header elements
	local function attachClick(element)
		if element:IsA("GuiButton") then
			element.MouseButton1Click:Connect(toggleDropdown)
		else
			element.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					toggleDropdown()
				end
			end)
		end
	end
	
	attachClick(configDropdown)
	for _, child in ipairs(configDropdown:GetChildren()) do
		if child ~= dropdownPanel and child:IsA("GuiObject") then
			attachClick(child)
		end
	end
	
	-- ============================================================================
	-- 5. SAVING & LOADING LOGIC
	-- ============================================================================
	local savedConfigs = {}
	
	local function applyConfig(configData)
		for _, object in ipairs(screenGui:GetDescendants()) do
			local path = object:GetFullName()
	
			local drag = object:FindFirstChild("sliderdrag")
			if drag and configData.sliders and configData.sliders[path] ~= nil then
				local percentage = configData.sliders[path]
				local fill = object:FindFirstChild("sliderfill")
				local label = object.Parent:FindFirstChild("value") or object:FindFirstChild("value")
	
				drag.Position = UDim2.new(percentage, 0, 0.5, 0)
				if fill then
					fill.Size = UDim2.new(percentage, 0, 1, 0)
					fill.Visible = (percentage > 0)
				end
				if label then
					label.Text = tostring(math.floor(percentage * 100))
				end
			end
	
			local circle = object:FindFirstChild("togglecircle")
			if circle and configData.toggles and configData.toggles[path] ~= nil then
				object:SetAttribute("IsEnabled", configData.toggles[path])
			end
		end
	end
	
	local function createConfigButton(name)
		if not dropdownPanel then return end
		if dropdownPanel:FindFirstChild("Config_" .. name) then return end
	
		local newButton = Instance.new("TextButton")
		newButton.Name = "Config_" .. name
		newButton.Text = name
		newButton.Size = UDim2.new(1, -4, 0, 26)
		newButton.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
		newButton.BackgroundTransparency = 0
		newButton.TextColor3 = Color3.fromRGB(255, 255, 255)
		newButton.FontFace = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.SemiBold)
		newButton.TextSize = 14
		newButton.ZIndex = dropdownPanel.ZIndex + 5
