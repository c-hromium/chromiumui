			targetPosition = UDim2.new(1, rightOffset, 0.5, 0)
			targetColor = ENABLED_COLOR
		else
			targetPosition = UDim2.new(0, PADDING, 0.5, 0)
			targetColor = ORIGINAL_COLOR
		end
	
